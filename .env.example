# =========================================================
#  FireGuard - modèle de configuration
#  1. Copier ce fichier en ".env" :   Copy-Item .env.example .env
#  2. Remplir les valeurs dans .env (jamais dans ce fichier).
#  3. Le fichier .env n'est JAMAIS commité (il est dans .gitignore).
# =========================================================

# --- Source vidéo et modèle ---
VIDEO_SOURCE=0
CAMERA_ID=cam01
MODEL_PATH=models/fireguard_best.pt

# --- Filtre temporel (anti-fausses alertes) ---
CONF_THRESHOLD=0.5
WINDOW_SIZE=10
MIN_POSITIVE_FRAMES=8
COOLDOWN_SECONDS=300

# --- Stockage ---
DB_PATH=evidence/events.db
EVIDENCE_DIR=evidence

# --- MQTT ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=fireguard/alerts

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000

# --- Notifications (utilisées par n8n) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_EMAIL_TO=
